---
interface Props { lang?: 'de' | 'en'; }
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---
<section class="section audiences-section" id="fuer-wen">
  <div class="container">
    <div class="section-header">
      <span class="section-label">{isEn ? 'For whom?' : 'Für wen?'}</span>
      <h2>{isEn ? 'For teams and individuals — ' : 'Für Teams und Einzelpersonen — '}<span class="text-gradient">{isEn ? 'your data first.' : 'deine Daten zuerst.'}</span></h2>
    </div>

    <!-- Audience Tabs -->
    <div class="audience-tabs">
      <button class="audience-tab active" data-audience="unternehmen" onclick="showAudience('unternehmen')">{isEn ? 'Companies' : 'Unternehmen'}</button>
      <button class="audience-tab" data-audience="privat" onclick="showAudience('privat')">{isEn ? 'Individuals' : 'Privatanwender'}</button>
    </div>

    <!-- UNTERNEHMEN (merged KMU + Enterprise) -->
    <div class="audience-panel active" id="audience-unternehmen">
      <div class="audience-hero">
        <h3>{isEn ? 'Your team already uses AI — now protect your data.' : 'Dein Team nutzt bereits KI — jetzt schütze deine Daten.'}</h3>
        <p>{isEn ? 'Every prompt with customer data or internal figures is a potential GDPR risk. AUSTR.AI gives your organization control — from small teams to enterprise, with a simple install or a full server deployment.' : 'Jeder Prompt mit Kundendaten oder internen Zahlen ist ein potenzielles DSGVO-Risiko. AUSTR.AI gibt deiner Organisation Kontrolle — vom kleinen Team bis zum Konzern, per einfacher Installation oder Server-Deployment.'}</p>
      </div>

      <div class="deploy-options">
        <h4>{isEn ? 'Deployment options' : 'Deployment-Optionen'}</h4>
        <div class="deploy-grid">
          <div class="deploy-card">
            <div class="deploy-header">
              <span class="deploy-badge">{isEn ? 'Small teams' : 'Kleine Teams'}</span>
              <h5>{isEn ? 'Local per workstation' : 'Lokal pro Arbeitsplatz'}</h5>
            </div>
            <p>{isEn ? 'Each employee installs AUSTR.AI locally. 5 minutes, no server needed.' : 'Jeder Mitarbeiter installiert AUSTR.AI lokal. 5 Minuten, kein Server nötig.'}</p>
            <ul>
              <li>{isEn ? 'Onboarding guides through setup' : 'Onboarding führt durch die Einrichtung'}</li>
              <li>{isEn ? 'Works with any AI provider' : 'Funktioniert mit jedem KI-Anbieter'}</li>
              <li>{isEn ? 'Each user brings their own API key' : 'Jeder User bringt eigenen API Key mit'}</li>
            </ul>
          </div>
          <div class="deploy-card deploy-card-accent">
            <div class="deploy-header">
              <span class="deploy-badge badge-accent">{isEn ? 'Recommended' : 'Empfohlen'}</span>
              <h5>{isEn ? 'Company server' : 'Firmen-Server'}</h5>
            </div>
            <p>{isEn ? 'Central deployment — team accesses the chat via browser from any device, including mobile.' : 'Zentrales Deployment — das Team greift per Browser zu, von jedem Gerät, auch mobil.'}</p>
            <ul>
              <li>{isEn ? 'Central deny-list management' : 'Zentrale Deny-List-Verwaltung'}</li>
              <li>{isEn ? 'One API key for all employees' : 'Ein API Key für alle Mitarbeiter'}</li>
              <li>{isEn ? 'DSGVO-compliant on your infrastructure' : 'DSGVO-konform auf eurer Infrastruktur'}</li>
            </ul>
          </div>
          <div class="deploy-card">
            <div class="deploy-header">
              <span class="deploy-badge">Docker</span>
              <h5>{isEn ? 'Container deployment' : 'Container-Deployment'}</h5>
            </div>
            <p>{isEn ? 'One command, ready to go.' : 'Ein Befehl, fertig.'}</p>
            <ul>
              <li><code>docker run -p 8282:8282 austrai/austrai</code></li>
              <li>{isEn ? '8+ GB RAM recommended' : '8+ GB RAM empfohlen'}</li>
              <li>{isEn ? '~8-15 EUR/month for cloud hosting' : '~8-15 EUR/Monat bei Cloud-Hosting'}</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="audience-expect">
        <h4>{isEn ? 'What you can expect — and what not' : 'Was du erwarten kannst — und was nicht'}</h4>
        <div class="expect-grid">
          <div class="expect-card expect-yes">
            <h5>{isEn ? 'This works' : 'Das funktioniert'}</h5>
            <ul>
              <li>{isEn ? 'IBANs, emails, phone numbers — 95%+ detection' : 'IBANs, E-Mails, Telefonnummern — 95%+ Erkennung'}</li>
              <li>{isEn ? 'Names with context — 85-92%' : 'Namen mit Kontext — 85-92%'}</li>
              <li>{isEn ? 'Confirmation step before every send' : 'Bestätigungsschritt vor jedem Senden'}</li>
              <li>{isEn ? 'Deny-list for company-specific terms (100% detection)' : 'Deny-List für firmenspezifische Begriffe (100% Erkennung)'}</li>
            </ul>
          </div>
          <div class="expect-card expect-no">
            <h5>{isEn ? 'Limitations' : 'Einschränkungen'}</h5>
            <ul>
              <li>{isEn ? 'No 100% guarantee — some data may slip through' : 'Keine 100% Garantie — es können Daten durchrutschen'}</li>
              <li>{isEn ? 'Trade secrets without personal reference' : 'Geschäftsgeheimnisse ohne Personenbezug'}</li>
              <li>{isEn ? 'Not a replacement for a data protection officer' : 'Kein Ersatz für einen Datenschutzbeauftragten'}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- PRIVATANWENDER -->
    <div class="audience-panel" id="audience-privat">
      <div class="audience-hero">
        <h3>{isEn ? 'Use AI without giving up your data.' : 'KI nutzen, ohne deine Daten herzugeben.'}</h3>
        <p>{isEn ? 'AUSTR.AI works like ChatGPT — but anonymizes your data before it reaches the AI and restores it in the response. Free for personal use, no account needed.' : 'AUSTR.AI funktioniert wie ChatGPT — anonymisiert aber deine Daten, bevor sie die KI erreichen, und stellt sie in der Antwort wieder her. Für Privatanwender kostenlos, kein Account nötig.'}</p>
      </div>

      <div class="audience-how">
        <h4>{isEn ? 'Get started in 3 steps' : 'In 3 Schritten loslegen'}</h4>
        <div class="how-steps">
          <div class="how-step">
            <div class="how-num">1</div>
            <div>
              <strong>{isEn ? 'Install' : 'Installieren'}</strong>
              <p><code>pip install austrai && aai setup && aai chat</code></p>
            </div>
          </div>
          <div class="how-step">
            <div class="how-num">2</div>
            <div>
              <strong>{isEn ? 'Choose your AI' : 'KI auswählen'}</strong>
              <p>{isEn ? 'Ollama for 100% local, or Claude, GPT, Mistral with your API key.' : 'Ollama für 100% lokal, oder Claude, GPT, Mistral mit deinem API Key.'}</p>
            </div>
          </div>
          <div class="how-step">
            <div class="how-num">3</div>
            <div>
              <strong>{isEn ? 'Chat — protected' : 'Chatten — geschützt'}</strong>
              <p>{isEn ? 'Chat normally. AUSTR.AI shows you what gets anonymized before sending.' : 'Ganz normal chatten. AUSTR.AI zeigt dir vor dem Senden, was anonymisiert wird.'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="faq-section" id="faq">
      <h3>{isEn ? 'Frequently asked questions' : 'Häufige Fragen'}</h3>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{isEn ? 'Does AUSTR.AI really run completely locally?' : 'Läuft AUSTR.AI wirklich komplett lokal?'}</summary>
          <p>{isEn ? 'Yes. Detection and anonymization happen 100% on your machine. The only network traffic occurs when you send the already-anonymized text to an AI provider.' : 'Ja. Erkennung und Anonymisierung passieren zu 100% auf deinem Rechner. Die einzige Netzwerkkommunikation entsteht, wenn du den bereits anonymisierten Text an einen KI-Anbieter sendest.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'What are codenames?' : 'Was sind Codenames?'}</summary>
          <p>{isEn ? '"Thomas Gruber" becomes "Arion", "Innovatech GmbH" becomes "Nexon Corp" — invented terms that can\'t be reverse-translated by an LLM. Structured data like IBANs become reference codes like [AT_IBAN_1].' : '"Thomas Gruber" wird zu "Arion", "Innovatech GmbH" wird zu "Nexon Corp" — erfundene Begriffe, die ein LLM nicht zurückübersetzen kann. Strukturierte Daten wie IBANs werden zu Referenz-Codes wie [AT_IBAN_1].'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'What is the confirmation step?' : 'Was ist der Bestätigungsschritt?'}</summary>
          <p>{isEn ? 'Before sending, AUSTR.AI shows a color-coded preview of all replacements. You confirm, edit, or cancel — nothing leaves without your approval.' : 'Vor dem Senden zeigt AUSTR.AI eine farblich markierte Vorschau aller Ersetzungen. Du bestätigst, bearbeitest oder brichst ab — nichts geht raus ohne deine Freigabe.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'Which AI providers are supported?' : 'Welche KI-Anbieter werden unterstützt?'}</summary>
          <p>{isEn ? 'Ollama (100% local), Claude, GPT, Mistral, and Gemini. Switch between providers anytime in the settings.' : 'Ollama (100% lokal), Claude, GPT, Mistral und Gemini. Jederzeit in den Einstellungen wechselbar.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'What is the detection rate?' : 'Wie hoch ist die Erkennungsrate?'}</summary>
          <p>{isEn ? 'Structured data (IBANs, emails, phone numbers): 95-99%. Names: 80-92%. Company names: 80-90%. Terms on the deny-list are detected 100%.' : 'Strukturierte Daten (IBANs, E-Mails, Telefonnummern): 95-99%. Namen: 80-92%. Firmennamen: 80-90%. Begriffe auf der Deny-List werden zu 100% erkannt.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'What is the deny-list?' : 'Was ist die Deny-List?'}</summary>
          <p>{isEn ? 'A list of terms that are always anonymized, regardless of automatic detection. Add company names, project names, customer abbreviations — anything the system should catch 100%.' : 'Eine Liste von Begriffen, die immer anonymisiert werden, unabhängig von der automatischen Erkennung. Firmennamen, Projektnamen, Kundenkürzel eintragen — alles, was das System zu 100% erkennen soll.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'Is AUSTR.AI GDPR-compliant?' : 'Ist AUSTR.AI DSGVO-konform?'}</summary>
          <p>{isEn ? 'AUSTR.AI supports data minimization (Art. 5), privacy by design (Art. 25), and security of processing (Art. 32). It is a technical tool, not a legal guarantee — a full assessment requires your data protection officer.' : 'AUSTR.AI unterstützt Datenminimierung (Art. 5), Privacy by Design (Art. 25) und Sicherheit der Verarbeitung (Art. 32). Es ist ein technisches Werkzeug, keine rechtliche Garantie — eine vollständige Bewertung erfordert deinen Datenschutzbeauftragten.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'What does AUSTR.AI cost?' : 'Was kostet AUSTR.AI?'}</summary>
          <p>{isEn ? 'Free for personal use. No registration, no fees, no user limits. The only costs: API keys for the AI providers you already use (or none with Ollama). For commercial use, contact info@austr.ai.' : 'Die Nutzung ist für Privatanwender vollständig kostenlos. Es fallen keine Registrierungsgebühren, keine laufenden Kosten und keine Nutzerlimits an. Du benötigst lediglich einen API-Schlüssel für den KI-Anbieter deiner Wahl — oder gar keinen, wenn du Ollama lokal betreibst. Für eine kommerzielle Nutzung wende dich bitte an info@austr.ai.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'Does AUSTR.AI also protect trade secrets?' : 'Schützt AUSTR.AI auch Geschäftsgeheimnisse?'}</summary>
          <p>{isEn ? 'Not automatically. AUSTR.AI detects personal data (names, numbers, addresses). A sentence like "we plan the acquisition in Q3" passes through unchanged. Use the deny-list for such terms.' : 'Nicht automatisch. AUSTR.AI erkennt personenbezogene Daten (Namen, Nummern, Adressen). Ein Satz wie "wir planen die Übernahme im Q3" geht unverändert durch. Nutze die Deny-List für solche Begriffe.'}</p>
        </details>
        <details class="faq-item">
          <summary>{isEn ? 'Can I use it on my phone?' : 'Kann ich AUSTR.AI am Handy nutzen?'}</summary>
          <p>{isEn ? 'Yes — install on a server and open the chat in your phone browser. The web UI is fully responsive. No standalone app needed.' : 'Ja — auf einem Server installieren und die Chat-Oberfläche im Handy-Browser öffnen. Die Web-Oberfläche ist voll responsiv. Keine eigenständige App nötig.'}</p>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .audiences-section { position: relative; }

  .audience-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 3rem;
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: 4px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    border: 1px solid var(--color-border);
  }
  .audience-tab {
    flex: 1;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dim);
    transition: all var(--transition-base);
    text-align: center;
  }
  .audience-tab:hover { color: var(--color-text-muted); }
  .audience-tab.active { background: var(--color-accent); color: white; }

  .audience-panel { display: none; animation: slideUp 0.3s ease; }
  .audience-panel.active { display: block; }
  @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .audience-hero { max-width: 720px; margin: 0 auto 2.5rem; text-align: center; }
  .audience-hero h3 { font-size: 1.5rem; margin-bottom: 1rem; }
  .audience-hero p { font-size: 1.0625rem; line-height: 1.7; margin: 0 auto; max-width: 640px; }
  .audience-hero p + p { margin-top: 0.75rem; }

  .audience-how, .deploy-options, .audience-expect, .audience-important { margin-bottom: 3rem; }
  .audience-how h4, .deploy-options h4, .audience-expect h4, .audience-important h4 {
    font-size: 1.25rem; margin-bottom: 1.5rem; text-align: center;
  }

  /* How steps */
  .how-steps { max-width: 600px; margin: 0 auto; }
  .how-step {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1rem 0; border-bottom: 1px solid var(--color-border);
  }
  .how-step:last-child { border-bottom: none; }
  .how-num {
    width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.875rem; font-weight: 700;
    background: rgba(13, 148, 136, 0.1); color: var(--color-accent);
    border: 1px solid rgba(13, 148, 136, 0.2);
  }
  .how-step strong { display: block; margin-bottom: 0.25rem; }
  .how-step p { font-size: 0.875rem; color: var(--color-text-muted); margin: 0; }

  /* Expect grid */
  .expect-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .expect-card {
    background: var(--color-bg-card); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 1.5rem;
  }
  .expect-card h5 { font-size: 1rem; margin-bottom: 0.75rem; }
  .expect-yes h5 { color: var(--color-success); }
  .expect-no h5 { color: var(--color-error); }
  .expect-card ul { list-style: none; }
  .expect-card li { font-size: 0.875rem; color: var(--color-text-muted); padding: 0.3rem 0; line-height: 1.5; }

  /* Deploy grid */
  .deploy-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .deploy-card {
    background: var(--color-bg-card); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 1.5rem;
    transition: all var(--transition-base);
  }
  .deploy-card:hover { border-color: var(--color-border-light); transform: translateY(-2px); }
  .deploy-card-accent { border-color: rgba(13, 148, 136, 0.3); }
  .deploy-header { margin-bottom: 0.75rem; }
  .deploy-badge {
    font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.5px; color: var(--color-text-dim);
    background: rgba(107, 107, 107, 0.1); padding: 2px 8px;
    border-radius: 4px; display: inline-block; margin-bottom: 0.5rem;
  }
  .badge-accent { color: var(--color-accent); background: rgba(13, 148, 136, 0.1); }
  .deploy-card h5 { font-size: 1.125rem; }
  .deploy-card > p { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1rem; line-height: 1.5; }
  .deploy-card ul { list-style: none; }
  .deploy-card li { font-size: 0.8125rem; color: var(--color-text-dim); padding: 0.25rem 0; }
  .deploy-card li::before { content: "-> "; color: var(--color-accent); }

  /* Important grid */
  .important-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .important-item {
    background: var(--color-bg-card); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 1.25rem;
  }
  .important-item strong { display: block; margin-bottom: 0.5rem; font-size: 0.9375rem; }
  .important-item p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  /* FAQ */
  .faq-section { margin-top: 4rem; }
  .faq-section h3 { font-size: 1.5rem; text-align: center; margin-bottom: 2rem; }
  .faq-list { max-width: 720px; margin: 0 auto; }
  .faq-item {
    border-bottom: 1px solid var(--color-border); padding: 1rem 0;
  }
  .faq-item summary {
    font-size: 0.9375rem; font-weight: 600; cursor: pointer;
    color: var(--color-text); padding: 0.25rem 0;
    list-style: none; display: flex; align-items: center; gap: 0.75rem;
  }
  .faq-item summary::before { content: "+"; color: var(--color-accent); font-size: 1.25rem; font-weight: 400; flex-shrink: 0; }
  .faq-item[open] summary::before { content: "-"; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.7;
    margin: 0.75rem 0 0 1.75rem; max-width: none;
  }

  @media (max-width: 900px) {
    .deploy-grid, .expect-grid, .important-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .audience-tabs {
      max-width: 100%;
    }
    .audience-tab {
      padding: 0.65rem 0.75rem;
      font-size: 0.8125rem;
    }
    .audience-hero h3 {
      font-size: 1.25rem;
    }
    .audience-hero p {
      font-size: 0.9375rem;
    }
    .faq-item summary {
      font-size: 0.875rem;
    }
    .faq-item p {
      margin-left: 1.25rem;
    }
  }
</style>

<script is:inline>
  function showAudience(which) {
    document.querySelectorAll('.audience-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.audience-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('audience-' + which).classList.add('active');
    document.querySelector('[data-audience="' + which + '"]').classList.add('active');
  }
</script>