---
---
<section class="section demo-section" id="demo">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Ausprobieren</span>
      <h2>Live-Demo</h2>
      <p>Teste AUSTR.AI direkt hier — schreibe eine Nachricht mit sensiblen Daten und sieh, wie die Anonymisierung funktioniert.</p>
    </div>

    <div class="demo-chat-wrapper">
      <!-- Privacy Notice -->
      <div class="demo-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <p>Demo nutzt <strong>Mistral AI</strong> (EU-gehostet). Dein Text wird anonymisiert, bevor er die Seite verlässt. Max. 5 Nachrichten pro Session. Verwende fiktive Daten oder die Beispiele.</p>
      </div>

      <!-- Chat Container -->
      <div class="demo-chat" id="demo-chat">
        <!-- Welcome Message -->
        <div class="demo-msg demo-msg--bot">
          <div class="demo-msg-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="demo-msg-body">
            <div class="demo-msg-text">Schreib mir eine Nachricht mit personenbezogenen Daten — ich zeige dir, wie AUSTR.AI sie automatisch anonymisiert, bevor die KI sie sieht.</div>
          </div>
        </div>
      </div>

      <!-- Anonymization Preview (shown before sending) -->
      <div class="demo-preview" id="demo-preview" hidden>
        <div class="demo-preview-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span id="demo-preview-count">0 Begriffe anonymisiert</span>
          <button class="demo-preview-close" id="demo-preview-close" type="button">&times;</button>
        </div>
        <div class="demo-preview-diff">
          <div class="demo-preview-col">
            <div class="demo-preview-label">Dein Text</div>
            <div class="demo-preview-text" id="demo-preview-original"></div>
          </div>
          <div class="demo-preview-arrow">→</div>
          <div class="demo-preview-col demo-preview-col--anon">
            <div class="demo-preview-label">Was die KI sieht</div>
            <div class="demo-preview-text" id="demo-preview-anon"></div>
          </div>
        </div>
        <div class="demo-preview-entities" id="demo-preview-entities"></div>
        <div class="demo-preview-actions">
          <button class="btn btn-secondary btn-sm" id="demo-preview-cancel">Abbrechen</button>
          <button class="btn btn-primary btn-sm" id="demo-preview-send">Absenden <span class="key-hint">Enter</span></button>
        </div>
      </div>

      <!-- Input Area -->
      <div class="demo-input-area" id="demo-input-area">
        <div class="demo-examples" id="demo-examples">
          <button class="demo-chip" data-example="0">Geschäfts-E-Mail</button>
          <button class="demo-chip" data-example="1">Arzt-Befund</button>
          <button class="demo-chip" data-example="2">Vertragsklausel</button>
        </div>
        <div class="demo-input-row">
          <textarea id="demo-input" class="demo-input" placeholder="Nachricht mit sensiblen Daten eingeben..." rows="1" maxlength="2000"></textarea>
          <button class="demo-send-btn" id="demo-send" type="button" title="Prüfen & Senden">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </button>
        </div>
        <div class="demo-input-hint" id="demo-input-hint">Enter = Prüfen — dann nochmal Enter = Absenden</div>
      </div>

      <!-- Session limit reached -->
      <div class="demo-limit" id="demo-limit" hidden>
        <p>Demo-Limit erreicht (5 Nachrichten). Für unbegrenzten Zugang:</p>
        <code>pip install austrai && aai chat</code>
      </div>
    </div>

    <!-- Feature Highlights below demo -->
    <div class="demo-features">
      <div class="demo-feature">
        <div class="demo-feature-icon">🔍</div>
        <div class="demo-feature-title">3-Schichten-Erkennung</div>
        <div class="demo-feature-desc">GLiNER + Presidio + optionales lokales LLM erkennen Namen, IBANs, Diagnosen, Adressen und mehr.</div>
      </div>
      <div class="demo-feature">
        <div class="demo-feature-icon">🏷</div>
        <div class="demo-feature-title">Semantische Codes</div>
        <div class="demo-feature-desc">[DATE_OF_BIRTH_1], [AT_SVNR_1] — das LLM versteht den Datentyp und verwechselt nichts.</div>
      </div>
      <div class="demo-feature">
        <div class="demo-feature-icon">🔒</div>
        <div class="demo-feature-title">4 Schutzklassen</div>
        <div class="demo-feature-desc">Jeder Datenpunkt wird klassifiziert: Intern (1h), Vertraulich (30min), Streng Vertraulich (5min Vault-TTL).</div>
      </div>
      <div class="demo-feature">
        <div class="demo-feature-icon">↩</div>
        <div class="demo-feature-title">Lokale Wiederherstellung</div>
        <div class="demo-feature-desc">Codenames werden in der Antwort automatisch durch deine echten Daten ersetzt — lokal, nie beim LLM.</div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---- Chat Demo Layout ---- */
  .demo-chat-wrapper {
    max-width: 720px;
    margin: 0 auto;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .demo-notice {
    display: flex; align-items: flex-start; gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    background: rgba(13, 148, 136, 0.05);
    border-bottom: 1px solid var(--color-border-light);
    font-size: 0.8125rem; line-height: 1.5; color: var(--color-text-muted);
  }
  .demo-notice svg { flex-shrink: 0; color: var(--color-accent); margin-top: 1px; }
  .demo-notice p { margin: 0; }

  /* ---- Chat Messages ---- */
  .demo-chat {
    padding: 1.25rem;
    min-height: 300px;
    max-height: 500px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .demo-msg {
    display: flex; gap: 0.625rem; max-width: 85%;
    animation: msgIn 250ms ease;
  }
  .demo-msg--user { align-self: flex-end; flex-direction: row-reverse; }
  .demo-msg--bot { align-self: flex-start; }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .demo-msg-avatar {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .demo-msg-avatar svg { width: 16px; height: 16px; }
  .demo-msg--bot .demo-msg-avatar { background: rgba(13, 148, 136, 0.1); color: var(--color-accent); }
  .demo-msg--user .demo-msg-avatar { background: rgba(124, 58, 237, 0.1); color: var(--color-accent-purple); }

  .demo-msg-body { flex: 1; min-width: 0; }
  .demo-msg-text {
    padding: 0.75rem 1rem; border-radius: var(--radius-md);
    font-size: 0.875rem; line-height: 1.6; white-space: pre-wrap;
  }
  .demo-msg--bot .demo-msg-text { background: var(--color-bg-alt); color: var(--color-text); }
  .demo-msg--user .demo-msg-text { background: var(--color-accent); color: #fff; }

  /* Privacy badge on user messages */
  .demo-msg-badge {
    display: inline-flex; align-items: center; gap: 4px;
    margin-top: 6px; padding: 2px 8px;
    border-radius: 20px; font-size: 0.6875rem; font-weight: 500;
    background: rgba(13, 148, 136, 0.08); color: var(--color-accent);
  }
  .demo-msg-badge svg { width: 10px; height: 10px; }

  /* Rehydration badge on bot messages */
  .demo-msg-restored {
    display: inline-flex; align-items: center; gap: 4px;
    margin-top: 6px; padding: 2px 8px;
    border-radius: 20px; font-size: 0.6875rem; font-weight: 500;
    background: rgba(22, 163, 74, 0.08); color: var(--color-success);
  }
  .demo-msg-restored svg { width: 10px; height: 10px; }

  /* "What the AI saw" toggle */
  .demo-msg-raw-toggle {
    display: inline-flex; align-items: center; gap: 4px;
    margin-top: 4px; padding: 2px 8px;
    border: none; background: none; cursor: pointer;
    font-size: 0.6875rem; color: var(--color-text-dim);
    transition: color var(--transition-fast);
  }
  .demo-msg-raw-toggle:hover { color: var(--color-accent); }
  .demo-msg-raw-toggle svg { width: 10px; height: 10px; }

  .demo-msg-raw {
    margin-top: 6px; padding: 0.625rem 0.875rem;
    background: var(--color-bg); border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm); font-size: 0.75rem; line-height: 1.5;
    font-family: var(--font-mono); color: var(--color-text-muted);
    white-space: pre-wrap; animation: msgIn 150ms ease;
  }
  .demo-msg-raw-label {
    font-size: 0.625rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--color-accent); margin-bottom: 4px;
  }

  /* Loading dots */
  .demo-typing { display: flex; gap: 4px; padding: 0.75rem 1rem; }
  .demo-typing-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-text-dim);
    animation: typingPulse 1.2s ease-in-out infinite;
  }
  .demo-typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .demo-typing-dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typingPulse { 0%, 60%, 100% { opacity: 0.3; } 30% { opacity: 1; } }

  /* ---- Anonymization Preview ---- */
  .demo-preview {
    border-top: 1px solid var(--color-border-light);
    padding: 1rem 1.25rem;
    background: rgba(13, 148, 136, 0.03);
  }
  .demo-preview-header {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.8125rem; font-weight: 600; color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .demo-preview-close {
    margin-left: auto; border: none; background: none; cursor: pointer;
    color: var(--color-text-dim); font-size: 1.25rem; line-height: 1;
  }
  .demo-preview-diff {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .demo-preview-col {
    padding: 0.75rem; border-radius: var(--radius-sm);
    background: var(--color-bg-card); border: 1px solid var(--color-border-light);
  }
  .demo-preview-col--anon { border-color: rgba(13, 148, 136, 0.3); }
  .demo-preview-label {
    font-size: 0.6875rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.04em; margin-bottom: 0.375rem;
    color: var(--color-text-dim);
  }
  .demo-preview-col--anon .demo-preview-label { color: var(--color-accent); }
  .demo-preview-text {
    font-size: 0.8125rem; line-height: 1.5; white-space: pre-wrap;
    max-height: 120px; overflow-y: auto;
  }
  .demo-preview-arrow {
    display: flex; align-items: center; color: var(--color-text-dim); font-size: 1.25rem;
  }
  .demo-preview-entities {
    display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 0.75rem;
  }
  .demo-preview-entity {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 8px; border-radius: 20px;
    background: var(--color-bg-alt); border: 1px solid var(--color-border);
    font-size: 0.6875rem;
  }
  .demo-preview-entity-type {
    font-weight: 600; font-family: var(--font-mono); font-size: 0.625rem;
  }
  .demo-preview-entity-old { color: var(--color-error); text-decoration: line-through; }
  .demo-preview-entity-new { color: var(--color-accent); font-family: var(--font-mono); }
  .demo-preview-actions {
    display: flex; justify-content: flex-end; gap: 8px;
  }
  .key-hint {
    display: inline-block; margin-left: 4px; padding: 1px 5px;
    font-size: 0.5625rem; font-weight: 600; background: rgba(255,255,255,0.2);
    border-radius: 3px;
  }

  /* Protection level badges */
  .demo-plevel {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px; border-radius: 50%;
    font-size: 0.5625rem; font-weight: 700; color: #fff; flex-shrink: 0;
  }
  .demo-plevel-1 { background: #6B7280; }
  .demo-plevel-2 { background: #3B82F6; }
  .demo-plevel-3 { background: #F59E0B; }
  .demo-plevel-4 { background: #EF4444; }

  /* Codename highlight in anonymized text */
  .demo-anon-hl { color: var(--color-accent); font-weight: 500; }

  /* ---- Input Area ---- */
  .demo-input-area {
    border-top: 1px solid var(--color-border-light);
    padding: 0.875rem 1.25rem;
  }
  .demo-examples {
    display: flex; gap: 6px; margin-bottom: 0.625rem; flex-wrap: wrap;
  }
  .demo-chip {
    padding: 4px 12px; border-radius: 20px;
    background: var(--color-bg-alt); border: 1px solid var(--color-border);
    font-size: 0.75rem; font-family: var(--font-sans); color: var(--color-text-muted);
    cursor: pointer; transition: all var(--transition-fast);
  }
  .demo-chip:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .demo-input-row {
    display: flex; gap: 8px; align-items: flex-end;
  }
  .demo-input {
    flex: 1; padding: 0.625rem 0.875rem;
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); font-family: var(--font-sans);
    font-size: 0.875rem; line-height: 1.5; resize: none;
    color: var(--color-text); outline: none;
    transition: border-color var(--transition-fast);
    max-height: 150px;
  }
  .demo-input:focus { border-color: var(--color-accent); }
  .demo-input::placeholder { color: var(--color-text-dim); }
  .demo-input:disabled { opacity: 0.5; cursor: not-allowed; }

  .demo-send-btn {
    width: 38px; height: 38px; border-radius: 50%; border: none;
    background: var(--color-accent); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all var(--transition-fast); flex-shrink: 0;
  }
  .demo-send-btn:hover { background: var(--color-accent-dark); }
  .demo-send-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .demo-send-btn svg { width: 18px; height: 18px; }

  .demo-input-hint {
    font-size: 0.6875rem; color: var(--color-text-dim); margin-top: 4px;
  }

  /* Session limit */
  .demo-limit {
    padding: 1.5rem; text-align: center; border-top: 1px solid var(--color-border-light);
  }
  .demo-limit p { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .demo-limit code {
    display: inline-block; padding: 0.5rem 1rem; border-radius: var(--radius-sm);
    background: var(--color-bg-alt); font-family: var(--font-mono); font-size: 0.8125rem;
    color: var(--color-accent); border: 1px solid var(--color-border);
  }

  /* ---- Feature highlights below demo ---- */
  .demo-features {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
    max-width: 720px; margin: 2rem auto 0;
  }
  .demo-feature { text-align: center; }
  .demo-feature-icon { font-size: 1.5rem; margin-bottom: 0.375rem; }
  .demo-feature-title { font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem; }
  .demo-feature-desc { font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.4; }

  @media (max-width: 640px) {
    .demo-preview-diff { grid-template-columns: 1fr; }
    .demo-preview-arrow { display: none; }
    .demo-features { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
(function() {
  var API_BASE = '';
  var MAX_MESSAGES = 5;
  var messageCount = 0;
  var pendingText = null;
  var pendingData = null;
  var isProcessing = false;

  var EXAMPLES = [
    'Sehr geehrter Herr Thomas Gruber,\n\nbezugnehmend auf unser Telefonat sende ich Ihnen die Rechnung der Innovatech Solutions GmbH (UID: ATU12345678).\n\nBitte überweisen Sie EUR 4.800,00 auf IBAN: AT48 3200 0000 1234 5678.\n\nBei Rückfragen: +43 1 234 5678 oder m.steinbauer@innovatech.at.\n\nMit freundlichen Grüßen,\nMaria Steinbauer',
    'Patient: Elisabeth Moser, geb. 12.05.1985\nSVNr: 1234 120585\nAdresse: Hauptstraße 42, 1010 Wien\n\nDiagnose: Spannungskopfschmerz (G44.2)\nMedikation: Ibuprofen 400mg bei Bedarf\n\nNächster Termin: 10.04.2026\nDr. Friedrich Haslinger, Ringstraße 15, 1010 Wien\nTel: +43 1 987 6543',
    'Zwischen der Alpentechnik Consulting GmbH (FN 543210a) und der Bergland Industrie AG (FN 987654b):\n\nVergütung: EUR 125.000,00 auf IBAN: AT61 1200 0000 9876 5432\nUID: ATU98765432\n\nAnsprechpartner: Dr. Katharina Wieser\nTel: +43 316 123 456, E-Mail: k.wieser@alpentechnik.at'
  ];

  var PROMPTS = [
    'Bestätige den Erhalt dieser E-Mail höflich und professionell.',
    'Fasse diesen Befund in einfacher Sprache für den Patienten zusammen.',
    'Prüfe diese Vertragsklausel auf mögliche rechtliche Schwachstellen.'
  ];

  // DOM
  var chat = document.getElementById('demo-chat');
  var inputEl = document.getElementById('demo-input');
  var sendBtn = document.getElementById('demo-send');
  var preview = document.getElementById('demo-preview');
  var previewOriginal = document.getElementById('demo-preview-original');
  var previewAnon = document.getElementById('demo-preview-anon');
  var previewCount = document.getElementById('demo-preview-count');
  var previewEntities = document.getElementById('demo-preview-entities');
  var inputArea = document.getElementById('demo-input-area');
  var limitBox = document.getElementById('demo-limit');
  var examplesEl = document.getElementById('demo-examples');

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function hlAnon(s) { return esc(s).replace(/\[([A-Z_]+_\d+)\]/g, '<span class="demo-anon-hl">[$1]</span>'); }

  // Auto-resize textarea
  inputEl.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 150) + 'px';
  });

  // Examples
  examplesEl.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-example]');
    if (!btn) return;
    var idx = parseInt(btn.dataset.example);
    inputEl.value = EXAMPLES[idx];
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 150) + 'px';
    inputEl.focus();
  });

  // Enter handling: first = preview, second = send
  inputEl.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (pendingData && !preview.hidden) {
        confirmSend();
      } else {
        startPreview();
      }
    }
  });

  sendBtn.addEventListener('click', function() {
    if (pendingData && !preview.hidden) {
      confirmSend();
    } else {
      startPreview();
    }
  });

  document.getElementById('demo-preview-send').addEventListener('click', confirmSend);
  document.getElementById('demo-preview-cancel').addEventListener('click', closePreview);
  document.getElementById('demo-preview-close').addEventListener('click', closePreview);

  // --- Preview: analyze text, show what will be anonymized ---
  function startPreview() {
    var text = inputEl.value.trim();
    if (!text || isProcessing) return;
    if (messageCount >= MAX_MESSAGES) return;

    pendingText = text;
    isProcessing = true;
    sendBtn.disabled = true;

    // Find matching example prompt
    var prompt = 'Beantworte diese Nachricht professionell und hilfsbereit auf Deutsch.';
    for (var i = 0; i < EXAMPLES.length; i++) {
      if (text === EXAMPLES[i]) { prompt = PROMPTS[i]; break; }
    }

    fetch(API_BASE + '/api/process', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text, prompt: prompt })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      pendingData = data;
      showPreview(data);
      isProcessing = false;
      sendBtn.disabled = false;
    })
    .catch(function(err) {
      addBotMessage('Fehler: ' + err.message);
      isProcessing = false;
      sendBtn.disabled = false;
    });
  }

  function showPreview(data) {
    var entities = data.entities || [];
    var count = entities.length;
    previewCount.textContent = count + ' Begriff' + (count !== 1 ? 'e' : '') + ' anonymisiert';
    previewOriginal.textContent = data.original_text || pendingText;
    previewAnon.innerHTML = hlAnon(data.anonymized_text || pendingText);

    previewEntities.innerHTML = entities.map(function(e) {
      var plevel = e.protection_level || 2;
      return '<span class="demo-preview-entity">' +
        '<span class="demo-plevel demo-plevel-' + plevel + '">' + plevel + '</span>' +
        '<span class="demo-preview-entity-type">' + esc(e.entity_type) + '</span> ' +
        '<span class="demo-preview-entity-old">' + esc(e.text) + '</span> → ' +
        '<span class="demo-preview-entity-new">' + esc(e.entity_type.startsWith('[') ? e.entity_type : 'Codename') + '</span>' +
        '</span>';
    }).join('');

    preview.hidden = false;
  }

  function closePreview() {
    preview.hidden = true;
    pendingData = null;
    inputEl.focus();
  }

  // --- Confirm: show messages, display result ---
  function confirmSend() {
    if (!pendingData) return;
    var data = pendingData;
    var text = pendingText;
    preview.hidden = true;
    pendingData = null;
    pendingText = null;

    messageCount++;

    // Add user message with badge
    var entityCount = (data.entities || []).length;
    addUserMessage(text, entityCount);

    // Clear input
    inputEl.value = '';
    inputEl.style.height = 'auto';

    // Hide examples after first message
    if (examplesEl) examplesEl.style.display = 'none';

    // Show typing indicator
    var typingId = addTyping();

    // Short delay to simulate processing, then show result
    setTimeout(function() {
      removeTyping(typingId);

      var rehydrated = data.llm_response_rehydrated || data.llm_response_anonymized || 'Keine Antwort erhalten.';
      var raw = data.llm_response_anonymized || null;
      var restoredCount = entityCount; // approximate

      addBotMessage(rehydrated, raw, restoredCount, entityCount);

      // Check limit
      if (messageCount >= MAX_MESSAGES) {
        inputArea.hidden = true;
        limitBox.hidden = false;
      }

      scrollChat();
    }, 600);
  }

  // --- Message rendering ---
  function addUserMessage(text, entityCount) {
    var shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
    var badge = entityCount > 0
      ? '<div class="demo-msg-badge">' + shield + ' ' + entityCount + ' anonymisiert</div>'
      : '';
    var html = '<div class="demo-msg demo-msg--user">' +
      '<div class="demo-msg-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>' +
      '<div class="demo-msg-body">' +
      '<div class="demo-msg-text">' + esc(text) + '</div>' +
      badge +
      '</div></div>';
    chat.insertAdjacentHTML('beforeend', html);
    scrollChat();
  }

  function addBotMessage(text, rawText, restoredCount, anonCount) {
    var shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
    var check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';

    var restoredBadge = '';
    if (restoredCount > 0) {
      restoredBadge = '<div class="demo-msg-restored">' + check + ' ' + restoredCount + ' wiederhergestellt</div>';
    }

    var rawToggle = '';
    var rawPanel = '';
    if (rawText && rawText !== text) {
      var rawId = 'raw-' + Date.now();
      rawToggle = '<button class="demo-msg-raw-toggle" data-raw="' + rawId + '">' + shield + ' Was die KI sah</button>';
      rawPanel = '<div class="demo-msg-raw" id="' + rawId + '" hidden>' +
        '<div class="demo-msg-raw-label">Roh-Antwort der KI (vor Wiederherstellung)</div>' +
        esc(rawText) +
        '</div>';
    }

    var html = '<div class="demo-msg demo-msg--bot">' +
      '<div class="demo-msg-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>' +
      '<div class="demo-msg-body">' +
      '<div class="demo-msg-text">' + formatText(text) + '</div>' +
      restoredBadge + rawToggle + rawPanel +
      '</div></div>';
    chat.insertAdjacentHTML('beforeend', html);

    // Wire raw toggle
    if (rawText) {
      chat.querySelector('[data-raw="' + rawId + '"]')?.addEventListener('click', function() {
        var el = document.getElementById(rawId);
        if (el) el.hidden = !el.hidden;
      });
    }

    scrollChat();
  }

  function addTyping() {
    var id = 'typing-' + Date.now();
    var html = '<div class="demo-msg demo-msg--bot" id="' + id + '">' +
      '<div class="demo-msg-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>' +
      '<div class="demo-msg-body"><div class="demo-typing"><div class="demo-typing-dot"></div><div class="demo-typing-dot"></div><div class="demo-typing-dot"></div></div></div></div>';
    chat.insertAdjacentHTML('beforeend', html);
    scrollChat();
    return id;
  }

  function removeTyping(id) {
    var el = document.getElementById(id);
    if (el) el.remove();
  }

  function scrollChat() {
    chat.scrollTop = chat.scrollHeight;
  }

  function formatText(text) {
    // Basic markdown-like formatting
    return esc(text)
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
  }
})();
</script>
