---
---
<section class="section download-section" id="install">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Installieren</span>
      <h2>Jetzt starten — <span class="text-gradient">in 60 Sekunden.</span></h2>
      <p>
        Lade die Desktop-App herunter oder installiere AUSTR.AI per Terminal.
        Alles läuft lokal auf deinem Rechner — keine Cloud, kein Drittanbieter.
      </p>
    </div>

    <div class="download-grid">
      <!-- Desktop App -->
      <div class="download-card download-card-primary">
        <div class="download-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <h3>Desktop App</h3>
        <p class="download-desc">Für macOS — Shield-Icon, Drag & Drop, One-Click Anonymisierung. Kein Terminal nötig.</p>
        <div class="download-badge">macOS · 1.5 GB · v1.0</div>
        <a href="https://github.com/flbcoat/austrai-privacyproxy/releases" class="btn btn-primary btn-lg download-btn" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Download für macOS
        </a>
        <span class="download-note">Windows-Version in Vorbereitung</span>
      </div>

      <!-- Terminal / pip -->
      <div class="download-card">
        <div class="download-icon download-icon-purple">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="4 17 10 11 4 5"/>
            <line x1="12" y1="19" x2="20" y2="19"/>
          </svg>
        </div>
        <h3>Terminal (pip)</h3>
        <p class="download-desc">Für Entwickler — CLI, API Proxy, Shell. Python 3.10+ erforderlich.</p>
        <div class="download-code">
          <code>pip install austrai</code>
        </div>
        <div class="download-commands">
          <code>aai anon "Dein Text hier"</code>
          <code>aai start &nbsp; # Proxy starten</code>
          <code>aai shell &nbsp; # Einstellungen</code>
        </div>
        <a href="https://pypi.org/project/austrai/" class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
          Auf PyPI ansehen
        </a>
      </div>

      <!-- GitHub -->
      <div class="download-card">
        <div class="download-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </div>
        <h3>Source Code</h3>
        <p class="download-desc">MIT-Lizenz. Frei nutzbar, veränderbar und erweiterbar. Auch kommerziell.</p>
        <a href="https://github.com/flbcoat/austrai-privacyproxy" class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
          Auf GitHub ansehen
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section {
    position: relative;
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .download-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    transition: all var(--transition-base);
  }

  .download-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .download-card-primary {
    border-color: rgba(6, 182, 212, 0.3);
    box-shadow: 0 0 24px rgba(6, 182, 212, 0.06);
  }

  .download-card-primary:hover {
    box-shadow: 0 0 32px rgba(6, 182, 212, 0.12);
  }

  .download-icon {
    color: var(--color-accent);
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
  }

  .download-icon-purple {
    color: var(--color-accent-purple);
  }

  .download-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .download-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .download-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .download-code {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-accent);
  }

  .download-commands {
    text-align: left;
    margin-bottom: 1.25rem;
  }

  .download-commands code {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    padding: 0.2rem 0;
  }

  .download-btn {
    width: 100%;
    justify-content: center;
  }

  .download-note {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
