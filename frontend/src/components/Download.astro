---
interface Props { lang?: 'de' | 'en'; }
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---
<section class="section download-section" id="install">
  <div class="container">
    <div class="section-header">
      <span class="section-label">{isEn ? 'Install' : 'Installieren'}</span>
      <h2>{isEn ? 'Two commands.' : 'Zwei Befehle.'} <span class="text-gradient">{isEn ? "That's it." : 'Mehr nicht.'}</span></h2>
      <p>
        {isEn ? 'Works on your laptop, your company server, or in Docker. The rest happens automatically.' : 'Funktioniert auf deinem Laptop, Firmenserver oder in Docker. Den Rest erledigt AUSTR.AI automatisch.'}
      </p>
    </div>

    <div class="download-grid">
      <!-- Main install (one card, prominent) -->
      <div class="download-card download-card-primary">
        <div class="download-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </div>
        <h3>{isEn ? 'Install & Start' : 'Installieren & Starten'}</h3>
        <div class="download-code" style="font-size: 1.1rem; padding: 1.25rem 1.5rem;">
          <code>pip install austrai</code><br>
          <code>aai chat</code>
        </div>
        <p class="download-desc" style="margin-top: 1rem;">
          {isEn
            ? 'That\'s all. AUSTR.AI downloads all required models automatically on first start, opens your browser, and guides you through the setup.'
            : 'Das ist alles. AUSTR.AI lädt beim ersten Start alle Modelle automatisch herunter, öffnet deinen Browser und führt dich durch die Einrichtung.'}
        </p>
        <div class="download-what-happens">
          <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 0.5rem;"><strong>{isEn ? 'What happens:' : 'Was passiert:'}</strong></p>
          <ol style="font-size: 0.8125rem; color: var(--color-text-muted); padding-left: 1.2rem; line-height: 1.8;">
            <li>{isEn ? 'Models are downloaded automatically (~1 GB, one-time)' : 'Modelle werden automatisch geladen (~1 GB, einmalig)'}</li>
            <li>{isEn ? 'Your browser opens with the setup wizard' : 'Dein Browser öffnet sich mit dem Einrichtungs-Assistenten'}</li>
            <li>{isEn ? 'Choose your AI provider (local with Ollama or cloud)' : 'Wähle deinen KI-Anbieter (lokal mit Ollama oder Cloud)'}</li>
            <li>{isEn ? 'Start chatting — with automatic privacy protection' : 'Loschatten — mit automatischem Datenschutz'}</li>
          </ol>
        </div>
        <a href="https://pypi.org/project/austrai/" class="btn btn-primary btn-lg download-btn" target="_blank" rel="noopener noreferrer">
          PyPI →
        </a>
        <span class="download-note">{isEn ? 'Requires Python 3.10+' : 'Benötigt Python 3.10+'}</span>
      </div>

      <!-- Server / Docker -->
      <div class="download-card">
        <div class="download-icon download-icon-purple">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
            <line x1="6" y1="6" x2="6.01" y2="6"/>
            <line x1="6" y1="18" x2="6.01" y2="18"/>
          </svg>
        </div>
        <h3>{isEn ? 'On your server' : 'Auf deinem Server'}</h3>
        <p class="download-desc">{isEn ? 'Same installation, but accessible from anywhere. Your team opens the URL in the browser — including on mobile.' : 'Gleiche Installation, aber von überall erreichbar. Dein Team öffnet die URL im Browser — auch am Handy.'}</p>
        <div class="download-code">
          <code>pip install austrai && aai chat --no-browser</code>
        </div>
        <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 0.75rem;">
          {isEn ? 'Or with Docker:' : 'Oder mit Docker:'}
        </p>
        <div class="download-code">
          <code>docker run -p 8282:8282 austrai/austrai</code>
        </div>
        <span class="download-note">{isEn ? 'Responsive — works on desktop, tablet, and phone.' : 'Responsive — funktioniert auf Desktop, Tablet und Handy.'}</span>
      </div>

      <!-- License -->
      <div class="download-card">
        <div class="download-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14,2 14,8 20,8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <h3>{isEn ? 'License' : 'Lizenz'}</h3>
        <p class="download-desc">{isEn ? 'Free for personal use. Commercial license available on request.' : 'Für Privatanwender kostenlos. Kommerzielle Lizenz auf Anfrage.'}</p>
        <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 0.75rem; line-height: 1.6;">
          {isEn ? 'No registration, no user limits, no telemetry. For business use, contact:' : 'Keine Registrierung, keine Nutzerlimits, keine Telemetrie. Für geschaeftliche Nutzung:'}
        </p>
        <a href="mailto:info@austr.ai" class="btn btn-secondary btn-lg" style="margin-top: 1rem;">
          info@austr.ai
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section { padding-block: 6rem; }
  .download-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .download-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .download-card-primary {
    border-color: rgba(13, 148, 136, 0.3);
    box-shadow: var(--shadow-glow);
  }
  .download-icon {
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(13, 148, 136, 0.08);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }
  .download-icon-purple {
    background: rgba(124, 58, 237, 0.08);
    color: var(--color-accent-purple);
  }
  .download-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .download-desc { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.6; }
  .download-code {
    background: #1e1e2e;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: #e0e0e0;
    overflow-x: auto;
  }
  .download-btn { margin-top: 1.25rem; display: inline-flex; }
  .download-note {
    display: block; margin-top: 0.75rem;
    font-size: 0.75rem; color: var(--color-text-dim);
  }

  @media (max-width: 900px) {
    .download-grid { grid-template-columns: 1fr; }
  }
</style>
