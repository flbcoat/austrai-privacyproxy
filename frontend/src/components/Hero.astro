---
interface Props { lang?: 'de' | 'en'; }
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-gradient"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-text">
      <div class="hero-version-badge animate-slide-up">
        <span class="hero-version-pill">v3.2.1</span>
        <span class="hero-beta-pill">BETA</span>
        <span class="hero-version-text">{isEn ? 'Skills, knowledge base, Austria-specific detection' : 'Skills, Wissensbasis, Österreich-Detection'}</span>
      </div>
      <h1 class="animate-slide-up">
        {isEn ? 'Chat with AI' : 'Chatte mit KI'} —<br />
        <span class="text-gradient">{isEn ? 'without exposing your data.' : 'ohne deine Daten preiszugeben.'}</span>
      </h1>
      <p class="hero-subtitle animate-slide-up animate-delay-1">
        {isEn ? 'AUSTR.AI automatically anonymizes your data before it ever reaches an AI model and transparently restores it in the response. Everything runs locally on your own machine, the service is free for personal use, and it is developed in Vienna, Austria.' : 'AUSTR.AI anonymisiert deine Daten automatisch, bevor sie ein KI-Modell erreichen, und stellt sie in der Antwort transparent wieder her. Die Verarbeitung findet vollständig auf deinem eigenen Rechner statt, die Nutzung ist für Privatanwender kostenlos — entwickelt in Wien.'}
      </p>
      <p class="hero-beta-notice animate-slide-up animate-delay-1">
        <span aria-hidden="true">⚠️</span>
        {isEn ? 'AUSTR.AI is in BETA — features evolve quickly, privacy guarantees stay constant.' : 'AUSTR.AI ist in der BETA-Phase — die Funktionen entwickeln sich schnell, die Datenschutz-Garantien bleiben konstant.'}
      </p>
      <div class="hero-actions animate-slide-up animate-delay-2">
        <a href={isEn ? '/en#install' : '#install'} class="btn btn-primary btn-lg">{isEn ? 'Get started free' : 'Kostenlos starten'}</a>
        <a href={isEn ? '/en#demo' : '#demo'} class="btn btn-secondary btn-lg">{isEn ? 'Live demo' : 'Live Demo'}</a>
      </div>
    </div>

    <div class="hero-visual animate-slide-up animate-delay-3">
      <div class="pipeline">
        <div class="pipeline-step">
          <div class="pipeline-box">
            <div class="pipeline-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14,2 14,8 20,8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
            </div>
            <span class="pipeline-label">{isEn ? 'Your message' : 'Deine Nachricht'}</span>
            <code class="pipeline-preview">{isEn ? '"Mr. Smith, IBAN: DE89..."' : '"Herr Gruber, IBAN: AT48..."'}</code>
          </div>

          <div class="pipeline-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none">
              <path d="M0 8h28M22 2l6 6-6 6" stroke="#0D9488" stroke-width="2"/>
            </svg>
          </div>

          <div class="pipeline-box pipeline-box-accent">
            <div class="pipeline-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <span class="pipeline-label">{isEn ? 'Anonymization' : 'Anonymisierung'}</span>
            <code class="pipeline-preview">"Herr <em>Arion</em>, IBAN: <em>[AT_IBAN_1]</em>"</code>
          </div>

          <div class="pipeline-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none">
              <path d="M0 8h28M22 2l6 6-6 6" stroke="#F59E0B" stroke-width="2"/>
            </svg>
          </div>

          <div class="pipeline-box pipeline-box-confirm">
            <div class="pipeline-icon icon-confirm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 11l3 3L22 4"/>
                <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
              </svg>
            </div>
            <span class="pipeline-label">{isEn ? 'You confirm' : 'Du bestätigst'}</span>
            <code class="pipeline-preview">{isEn ? 'Check & approve' : 'Prüfen & freigeben'}</code>
          </div>

          <div class="pipeline-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none">
              <path d="M0 8h28M22 2l6 6-6 6" stroke="#7C3AED" stroke-width="2"/>
            </svg>
          </div>

          <div class="pipeline-box pipeline-box-purple">
            <div class="pipeline-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
                <path d="M7 8h2M11 8h2M15 8h2M7 11h6"/>
              </svg>
            </div>
            <span class="pipeline-label">LLM</span>
            <code class="pipeline-preview">{isEn ? 'AI sees only' : 'KI sieht nur'}<br />{isEn ? 'anonymous data' : 'anonyme Daten'}</code>
          </div>

          <div class="pipeline-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none">
              <path d="M0 8h28M22 2l6 6-6 6" stroke="#0D9488" stroke-width="2"/>
            </svg>
          </div>

          <div class="pipeline-box">
            <div class="pipeline-icon icon-success">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20,6 9,17 4,12"/>
              </svg>
            </div>
            <span class="pipeline-label">{isEn ? 'Restored' : 'Wiederhergestellt'}</span>
            <code class="pipeline-preview">{isEn ? 'Response with' : 'Antwort mit'}<br />{isEn ? 'your real data' : 'deinen echten Daten'}</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 8rem 0 5rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(13, 148, 136, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 148, 136, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    animation: gridMove 20s linear infinite;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 50%, rgba(13, 148, 136, 0.08), transparent),
      radial-gradient(ellipse 40% 40% at 80% 30%, rgba(124, 58, 237, 0.06), transparent),
      linear-gradient(to bottom, transparent 60%, var(--color-bg));
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-text {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.7;
    margin: 1.5rem auto 0;
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  /* Pipeline visual */
  .hero-visual {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem 0;
  }

  .pipeline {
    max-width: 1100px;
    margin: 0 auto;
  }

  .pipeline-step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pipeline-box {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    text-align: center;
    min-width: 140px;
    max-width: 170px;
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .pipeline-box:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .pipeline-box-accent {
    border-color: rgba(13, 148, 136, 0.3);
    box-shadow: 0 0 16px rgba(13, 148, 136, 0.08);
  }

  .pipeline-box-confirm {
    border-color: rgba(245, 158, 11, 0.3);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.08);
  }

  .pipeline-box-purple {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 0 16px rgba(124, 58, 237, 0.08);
  }

  .pipeline-icon {
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: center;
  }

  .pipeline-box-purple .pipeline-icon {
    color: var(--color-accent-purple);
  }

  .icon-confirm {
    color: #F59E0B;
  }

  .icon-success {
    color: var(--color-success);
  }

  .pipeline-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  /* Version + BETA badge above the H1, plus a quiet beta notice line. */
  .hero-version-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .hero-version-pill {
    background: rgba(13, 148, 136, 0.12);
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .hero-beta-pill {
    background: #fbbf24;
    color: #78350f;
    font-weight: 700;
    font-size: 0.6875rem;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.06em;
  }
  .hero-version-text {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }
  /* Centered, pill-style notice — matches the centered hero-text layout
     and renders consistently across mobile + desktop. The earlier
     border-left version sat off-axis under the centered subtitle. */
  .hero-beta-notice {
    margin: 1rem auto 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 14px;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 999px;
    max-width: max-content;
  }

  .pipeline-preview {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    font-family: var(--font-mono);
  }

  .pipeline-preview em {
    color: var(--color-accent);
    font-style: normal;
  }

  .pipeline-box-accent .pipeline-preview em {
    color: var(--color-accent-light);
  }

  .pipeline-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .pipeline-step {
      flex-direction: column;
      gap: 0.75rem;
    }

    .pipeline-arrow {
      transform: rotate(90deg);
    }

    .pipeline-box {
      min-width: 240px;
      max-width: 300px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 0 3rem;
      min-height: auto;
    }

    .hero-text {
      margin-bottom: 2rem;
    }

    .hero-subtitle {
      font-size: 1.0625rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .pipeline-box {
      min-width: 200px;
      max-width: 100%;
    }
  }
</style>