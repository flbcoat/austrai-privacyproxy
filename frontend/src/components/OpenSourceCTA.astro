---
interface Props { lang?: 'de' | 'en'; }
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---
<section class="section open-source" id="open-source">
  <div class="container">
    <div class="oss-wrapper">
      <div class="oss-content">
        <span class="section-label">{isEn ? 'Get started' : 'Loslegen'}</span>
        <h2>{isEn ? 'Free to use.' : 'Kostenlos nutzbar.'}<br /><span class="text-gradient">Made in Austria.</span></h2>
        <p class="oss-desc">
          {isEn ? <Fragment>AUSTR.AI is free to use for private individuals. All processing happens locally on your own device, without telemetry and without any form of tracking. Install the tool with <code>pip install austrai</code> and start a protected conversation within seconds.</Fragment> : <Fragment>AUSTR.AI ist für Privatpersonen kostenfrei nutzbar. Die gesamte Verarbeitung findet lokal auf deinem eigenen Gerät statt, ohne Telemetrie und ohne jede Form von Tracking. Mit <code>pip install austrai</code> ist das Tool in wenigen Sekunden einsatzbereit.</Fragment>}
        </p>

        <ul class="oss-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg>
            <span><strong>{isEn ? 'Free for personal use' : 'Für Privatanwender kostenfrei'}</strong> — {isEn ? 'no registration, no usage limits and no hidden costs' : 'ohne Registrierung, ohne Nutzungslimits und ohne versteckte Kosten'}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg>
            <span><strong>{isEn ? 'Transparent processing' : 'Transparente Verarbeitung'}</strong> — {isEn ? 'every step of the data processing takes place locally on your device' : 'jeder Schritt der Datenverarbeitung findet lokal auf deinem Gerät statt'}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg>
            <span><strong>{isEn ? 'Local or cloud' : 'Lokal oder Cloud'}</strong> — {isEn ? 'Ollama for a fully local setup, or Claude, GPT, Mistral and Gemini via your own API keys' : 'Ollama für den vollständig lokalen Betrieb oder Claude, GPT, Mistral und Gemini über deine eigenen API-Schlüssel'}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg>
            <span><strong>{isEn ? 'Commercial use' : 'Kommerzielle Nutzung'}</strong> — {isEn ? 'a business licence is available on request at info@austr.ai' : 'eine Unternehmenslizenz ist auf Anfrage unter info@austr.ai erhältlich'}</span>
          </li>
        </ul>

        <div class="oss-actions">
          <a href={isEn ? '/en#install' : '#install'} class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {isEn ? 'Get started free' : 'Kostenlos starten'}
          </a>
        </div>
      </div>

      <div class="oss-tech">
        <h4>Tech Stack</h4>
        <div class="oss-pills">
          <span class="pill">Python</span>
          <span class="pill">GLiNER</span>
          <span class="pill">Presidio</span>
          <span class="pill">SpaCy</span>
          <span class="pill pill-purple">pip install</span>
          <span class="pill">FastAPI</span>
          <span class="pill">LiteLLM</span>
          <span class="pill pill-purple">Whisper</span>
          <span class="pill">Docker</span>
        </div>

        <div class="oss-architecture">
          <h4>{isEn ? 'Architecture' : 'Architektur'}</h4>
          <div class="oss-arch-diagram">
            <div class="oss-arch-box">
              <span class="oss-arch-label">{isEn ? 'Chat UI (Browser)' : 'Chat-Oberflaeche (Browser)'}</span>
              <span class="oss-arch-tech">{isEn ? 'Responsive Web UI' : 'Responsive Web-Oberflaeche'}</span>
            </div>
            <div class="oss-arch-arrow" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="oss-arch-box oss-arch-box-accent">
              <span class="oss-arch-label">AUSTR.AI Engine</span>
              <span class="oss-arch-tech">GLiNER + Presidio + FastAPI</span>
            </div>
            <div class="oss-arch-arrow" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="oss-arch-box oss-arch-box-purple">
              <span class="oss-arch-label">{isEn ? 'LLM (Ollama / Claude / GPT / Mistral)' : 'LLM (Ollama / Claude / GPT / Mistral)'}</span>
              <span class="oss-arch-tech">{isEn ? 'via LiteLLM — local or cloud' : 'via LiteLLM — lokal oder Cloud'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .open-source {
    position: relative;
    overflow: hidden;
  }

  .open-source::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
  }

  .oss-wrapper {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .oss-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-top: 1.25rem;
  }

  .oss-features {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .oss-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .oss-features li svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .oss-features li strong {
    color: var(--color-text);
  }

  .oss-actions {
    margin-top: 2.5rem;
  }

  .oss-tech {
    padding-top: 1rem;
  }

  .oss-tech h4 {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .oss-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .oss-architecture {
    margin-top: 0;
  }

  .oss-arch-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .oss-arch-box {
    width: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    text-align: center;
  }

  .oss-arch-box-accent {
    border-color: rgba(13, 148, 136, 0.3);
    box-shadow: 0 0 12px rgba(13, 148, 136, 0.08);
  }

  .oss-arch-box-purple {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 0 12px rgba(124, 58, 237, 0.08);
  }

  .oss-arch-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .oss-arch-tech {
    display: block;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-dim);
    margin-top: 0.2rem;
  }

  .oss-arch-arrow {
    color: var(--color-text-dim);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .oss-wrapper {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
