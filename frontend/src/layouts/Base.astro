---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AUSTR.AI PrivacyProxy — Privacy Firewall fuer KI-Dienste',
  description = 'PrivacyProxy schuetzt sensible Daten in LLM-Prompts: Namen, IBANs, Passwoerter, Diagnosen, IP-Adressen. Laeuft komplett lokal. DSGVO-konform. Open Source aus Oesterreich.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="FLB.CO.AT — Florian Bieche" />
  <meta name="keywords" content="Privacy, Datenschutz, DSGVO, KI, AI, Anonymisierung, LLM, ChatGPT, Claude, Open Source, Oesterreich, Austria" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="AUSTR.AI" />
  <meta property="og:locale" content="de_AT" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AUSTR.AI PrivacyProxy",
    "description": "Open-Source Privacy Firewall für KI-Dienste. Anonymisiert sensible Daten lokal bevor sie an LLMs gesendet werden.",
    "applicationCategory": "SecurityApplication",
    "operatingSystem": "macOS, Windows, Linux",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
    "author": { "@type": "Organization", "name": "FLB.CO.AT", "url": "https://flb.co.at" },
    "url": "https://austr.ai",
    "downloadUrl": "https://pypi.org/project/austrai/",
    "softwareVersion": "1.0.0",
    "license": "https://opensource.org/licenses/MIT",
    "inLanguage": "de",
    "keywords": "Privacy, DSGVO, Anonymisierung, LLM, KI, Open Source"
  })} />

  <title>{title}</title>
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
